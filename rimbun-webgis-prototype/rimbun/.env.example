# Salin file ini menjadi `.env.local` (di folder yang sama) untuk testing lokal dengan Supabase.
# File `.env.local` otomatis diabaikan Git (.gitignore) agar kunci proyek Anda tetap rapi.

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
